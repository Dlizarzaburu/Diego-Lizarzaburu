# ---- Local development environment (safe defaults, no real secrets) ----
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/s27events?schema=public"

# App
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Auth — session signing secret (dev only; generate a strong one for prod)
AUTH_SECRET="replace-with-a-long-random-string"

# Payments (Stripe). Leave blank to run the built-in safe DEV payment mode.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
PAYMENTS_MODE="dev"

# Email provider. "dev" writes emails to ./dev-outbox instead of sending.
EMAIL_MODE="dev"
EMAIL_FROM="S27 Events <tickets@s27events.dev>"
RESEND_API_KEY=""

# Yappy (Banco General, Panamá) — future payment integration. Leave blank to
# keep using dev/Stripe. Set PAYMENTS_MODE=yappy once both are provided.
YAPPY_MERCHANT_ID=""
YAPPY_SECRET=""

# Apple Wallet passes (optional). Needed to hand out .pkpass tickets. Requires
# an Apple Developer "Pass Type ID" certificate.
APPLE_WALLET_PASS_TYPE_ID=""
APPLE_WALLET_TEAM_ID=""
APPLE_WALLET_CERT=""          # base64-encoded .p12
APPLE_WALLET_CERT_PASSWORD=""
APPLE_WALLET_WWDR=""          # base64-encoded Apple WWDR cert
