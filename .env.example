# ---- Local development environment (safe defaults, no real secrets) ----
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/s27events?schema=public"

# App
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Auth — session signing secret (dev only; generate a strong one for prod)
AUTH_SECRET="replace-with-a-long-random-string"

# Payments (Stripe). Leave blank to run the built-in safe DEV payment mode.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
PAYMENTS_MODE="dev"

# Email provider. "dev" writes emails to ./dev-outbox instead of sending.
EMAIL_MODE="dev"
EMAIL_FROM="S27 Events <tickets@s27events.dev>"
RESEND_API_KEY=""
